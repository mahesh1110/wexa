# Never commit .env. Use one set of variables per platform.
COGNODB_URI=bolt+s://replace-me.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=
COGNODB_SPECS=0.5 vCPU; 256 MB RAM; 1 GB disk; region=record-me

NEO4J_AURA_URI=neo4j+s://replace-me.databases.neo4j.io
NEO4J_AURA_USER=neo4j
NEO4J_AURA_PASSWORD=
NEO4J_AURA_SPECS=record console-advertised limits; region=record-me

MEMGRAPH_URI=bolt+s://replace-me
MEMGRAPH_USER=memgraph
MEMGRAPH_PASSWORD=
MEMGRAPH_SPECS=record console-advertised limits; region=record-me

FALKORDB_HOST=replace-me
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH=benchmark
FALKORDB_SSL=true
FALKORDB_SPECS=100 MB RAM; max graph dataset 100 MB; region=record-me

GRAPHBENCH_BATCH_SIZE=1000

ARANGO_URL=https://replace-me
ARANGO_USER=root
ARANGO_PASSWORD=
ARANGO_DATABASE=_system
ARANGO_USERS_COLLECTION=benchmark_users
ARANGO_EDGES_COLLECTION=benchmark_follows
ARANGO_SPECS=record managed-plan vCPU; RAM; storage; region
