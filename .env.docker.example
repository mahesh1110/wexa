# Local Docker benchmark endpoints. These are intentionally separate from cloud credentials.
LOCAL_NEO4J_PASSWORD=graphbench_neo4j
NEO4J_DOCKER_URI=bolt://localhost:17687
NEO4J_DOCKER_DATABASE=neo4j

MEMGRAPH_DOCKER_URI=bolt://localhost:27687

LOCAL_FALKORDB_PASSWORD=graphbench_falkordb
FALKORDB_DOCKER_PORT=36379
FALKORDB_DOCKER_GRAPH=benchmark

LOCAL_ARANGO_PASSWORD=graphbench_arango
ARANGO_DOCKER_URL=http://localhost:18529
ARANGO_DOCKER_DATABASE=_system

# The compose file applies 0.5 CPU, 512 MB RAM, and a 1 GB writable layer to each service.

GRAPHBENCH_BATCH_SIZE=5000
